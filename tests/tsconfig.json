{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node", "vitest/globals"],
    "baseUrl": "..",
    "paths": {
      "@allaya/*": ["packages/*/src/index.ts"],
